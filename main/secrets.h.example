/**
 * 本地凭据模板 —— 复制为 secrets.h 后填入你自己的值。
 *
 *   copy secrets.h.example secrets.h
 *
 * ⚠️ secrets.h 已在 .gitignore 中忽略，**不会**进入仓库。
 *    本项目计划开源，请务必不要把真实密码写进 secrets.h.example
 *    或任何会被提交的文件里。
 *
 * 自检（确认没被跟踪）：
 *   git check-ignore -v main/secrets.h
 */

#ifndef SMARTFARM_SECRETS_H
#define SMARTFARM_SECRETS_H

/* ---------------- WiFi ---------------- */
#define SECRET_WIFI_SSID      "PUT_YOUR_WIFI_SSID"
#define SECRET_WIFI_PASSWORD  "PUT_YOUR_WIFI_PASSWORD"

/* ---------------- HiveMQ Cloud (MQTT over TLS) ----------------
 * 地址取自 HiveMQ Cloud 控制台 Overview 页的 "TLS MQTT URL"。
 * 注意：HiveMQ Cloud **不支持明文连接**，必须使用 mqtts:// 与 8883 端口。
 *
 * 用户名/密码在控制台的 Access Management 标签页创建。
 * 建议给设备单独建一个账号，并只授权它需要的主题（最小权限）。 */
#define SECRET_MQTT_URI       "mqtts://YOUR_BROKER_ID.s1.eu.hivemq.cloud:8883"
#define SECRET_MQTT_USERNAME  "PUT_YOUR_MQTT_USERNAME"
#define SECRET_MQTT_PASSWORD  "PUT_YOUR_MQTT_PASSWORD"

/* ---------------- BLE 配对 Passkey ----------------
 * 手机首次与设备配对时要求输入的 6 位数字。
 *
 * ⚠️ 必须改成**你自己的随机 6 位数**。默认值 123456 写在开源仓库的
 *    net_config.h 里 = **公开的**——同一蓝牙范围内知道它的人就能配对
 *    并操作继电器。别用生日、手机号、连续数字。
 *
 *    生成示例（取 100000–999999，首位非 0）：
 *      PowerShell:  [Random]::new().Next(100000,999999)
 *      bash:        shuf -i 100000-999999 -n 1
 *
 * 固件启动时会明确提示当前用的是"默认公开值"还是"已自定义"，
 * 但**不会**打印这个值本身（凭据不进日志，见 README 第 8 条坑）。
 * 已配对过的手机以后自动重连，不需要再次输入。 */
#define SECRET_BLE_PASSKEY    123456

#endif /* SMARTFARM_SECRETS_H */
